    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:git": "tsx test/git.test.ts",
    "test:gatekeeper": "tsx test/gatekeeper.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@openai/codex-sdk": "^0.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
