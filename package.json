{
  "name": "codearena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dual-AI software development platform: one model builds, another gatekeeps.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "arena": "tsx src/cli/arena.ts",
