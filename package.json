{
  "name": "codearena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dual-AI software development platform: one model builds, another gatekeeps.",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "arena": "tsx src/cli/arena.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "test:git": "tsx test/git.test.ts",
    "test:gatekeeper": "tsx test/gatekeeper.test.ts",
    "test": "tsx test/policy.test.ts && tsx test/conventions.test.ts && tsx test/git.test.ts",
    "test:policy": "tsx test/policy.test.ts",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --packages=external --external:electron --outfile=dist-electron/main.js",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build:renderer": "vite build",
    "app": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@openai/codex-sdk": "^0.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  },
  "main": "dist-electron/main.js"
}
